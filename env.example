DB_HOST=localhost
DB_PORT=3306
DB_NAME=geo_lo
DB_USER=root
DB_PASSWORD=
APP_URL=http://localhost:8080
# Set DB_SSL=1 for hosted MySQL (TiDB Cloud, etc.). Leave off for local XAMPP.
# DB_SSL=1
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Website: "Get Started" onboarding form, payment verification and owner console
# Both Paystack keys must belong to the same account. The public key is handed to the
# browser by website/paystack-config.php; the secret key only ever lives on the server.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
# Sender address. onboarding@resend.dev only delivers to the Resend account owner, so
# verify a domain and switch this to something like: Geo-Lo <no-reply@yourdomain.com>
MAIL_FROM=Geo-Lo <onboarding@resend.dev>

# Owner account seeded on first boot. Leave OWNER_PASSWORD blank to have a random one
# generated; whoever signs in is asked to set their own password straight away.
OWNER_PASSWORD=
# boss@geo-lo is not a real mailbox, so reset codes for the owner go here instead.
OWNER_RECOVERY_EMAIL=

# APP_ENV=production turns off dev conveniences (API errors stop echoing internals).
# APP_TIMEZONE must match the zone your shifts are written in, e.g. Africa/Accra.
# APP_ENV=production
# APP_TIMEZONE=Africa/Accra
